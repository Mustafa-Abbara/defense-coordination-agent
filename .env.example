# Copy this file to .env and fill in the values:   copy .env.example .env
# .env is ignored by git. Never commit real values, and never put them in code.
# Every name here is a field of app/core/config.py -> Settings (a test keeps them in sync).
# Secret values must stay empty in this file.

# dev | test | prod
APP_ENV=dev
# Simulation controls (/api/sim/*). Keep false unless you are running the demo.
DEMO_MODE=false
# LLM provider key (ST-06). Leave empty here; put the real key only in .env.
LLM_API_KEY=
# Folder with policy.yaml, reminders.yaml, models.yaml (relative to where you run the app).
CONFIG_DIR=config
